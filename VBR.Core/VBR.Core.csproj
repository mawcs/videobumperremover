<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>VBR.Core</RootNamespace>
    <!-- Single-file/AOT publish: IL3000 flags HardwareAcceleration.ProbeOneDevice's
         Assembly.GetEntryAssembly()?.Location call. That call only executes inside the
         "processPath's filename is literally dotnet" branch (the `dotnet run`/`dotnet exec`
         shared-host case), unreachable once VBR.CLI is published single-file, since there
         Environment.ProcessPath already IS the app's own exe and that branch is skipped
         entirely. The trimmer can't prove that statically; our usage is covered. -->
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VBR.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VDF.Core\VDF.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DXGI adapter enumeration only (docs/decisions/0013-gpu-acceleration.md), picking a real
         GPU's device index for DirectML, not touching D3D11/D3D12 rendering at all. A thin,
         actively-maintained managed wrapper beats hand-rolled COM interop for this. -->
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
